{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "include": ["shared/**/*.ts", "src/**/*.ts", "tests/**/*.ts"],
  "exclude": [
    "src/self-hosted/**",
    "src/platform/sqlite/**",
    "src/platform/fs-object-store/**",
    "tests/platform/**",
    "tests/self-hosted/**",
    "tests/web/**",
    "src/mcp/standalone.ts"
  ]
}

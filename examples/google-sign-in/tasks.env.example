# Copy to tasks.env and fill in. Keep the real file out of version control.
ENVIRONMENT=production
# Any non-empty identifier for this deployment (a version or commit); /healthz reports it.
RELEASE_SHA=my-first-deploy

# Where the application is reached by browsers (must match the OAuth redirect URI host).
TASKS_PUBLIC_ORIGIN=https://tasks.example.org

# SQLite database and filesystem object storage on the /data volume.
TASKS_DATASTORE=sqlite
TASKS_SQLITE_PATH=/data/tasks.db
TASKS_OBJECT_STORE=filesystem
TASKS_OBJECT_STORE_PATH=/data/objects

# Google OAuth client (type "Web application"); add TASKS_PUBLIC_ORIGIN/auth/callback as a redirect URI.
GOOGLE_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
# Signs session cookies; anyone who knows it can sign in as any user. Generate your own, at least
# 32 random characters: openssl rand -hex 32. Left empty on purpose, so production refuses to
# start until you set it.
SESSION_SECRET=

# Optional: only accounts in this email domain may sign in. No default (any Google account).
TASKS_HOSTED_DOMAIN=example.org
# The first administrator: granted every permission when they first sign in. No default.
TASKS_INITIAL_ADMIN_EMAIL=admin@example.org

# Optional: the MCP server for agents (see docs/HOSTING.md, "MCP server"). Off by default.
# Create a credential with: node dist/mcp-create-credential.js --name "My agent" --scope read_write
# then paste the printed entry into the registry below. The registry is a secret.
# TASKS_MCP_ENABLED=true
# TASKS_MCP_AUTH_MODE=token
# TASKS_MCP_CREDENTIALS_JSON={"version":1,"credentials":[<entry printed by the command>]}

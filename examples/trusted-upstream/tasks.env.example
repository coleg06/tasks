# Copy to tasks.env and fill in. Keep the real file out of version control.
ENVIRONMENT=production
RELEASE_SHA=1.8.0
TASKS_PUBLIC_ORIGIN=https://tasks.example.org

TASKS_DATASTORE=sqlite
TASKS_SQLITE_PATH=/data/tasks.db
TASKS_OBJECT_STORE=filesystem
TASKS_OBJECT_STORE_PATH=/data/objects

# Identity comes from the reverse proxy in front of the application (oauth2-proxy, Authentik, ...).
TASKS_AUTH_MODE=trusted-upstream
# The header your proxy sets to the authenticated user's email. Required, no default.
TASKS_TRUSTED_UPSTREAM_EMAIL_HEADER=X-Forwarded-Email
# Optional display name header.
TASKS_TRUSTED_UPSTREAM_NAME_HEADER=X-Forwarded-User
# Explicit acknowledgement that only the proxy can reach this application and that it replaces
# the headers above on every request. Must be exactly this value.
TASKS_TRUSTED_UPSTREAM_TRUST=proxy-replaces-headers

# Optional domain restriction and the first administrator. No defaults.
TASKS_HOSTED_DOMAIN=example.org
TASKS_INITIAL_ADMIN_EMAIL=admin@example.org

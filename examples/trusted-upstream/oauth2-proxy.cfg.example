# Minimal oauth2-proxy configuration (copy to oauth2-proxy.cfg and fill in). With
# pass_user_headers, oauth2-proxy sets X-Forwarded-User and X-Forwarded-Email on the requests it
# forwards, which is what TASKS_TRUSTED_UPSTREAM_EMAIL_HEADER names. Check your proxy's version
# and settings to confirm it overwrites, never passes through, a value the client sent.
provider = "google"
client_id = "replace-with-your-client-id.apps.googleusercontent.com"
client_secret = "replace-with-your-client-secret"
# At least 32 random bytes, base64 or hex encoded.
cookie_secret = "replace-with-a-random-secret"
cookie_secure = true
email_domains = ["example.org"]
redirect_url = "https://tasks.example.org/oauth2/callback"
http_address = "0.0.0.0:4180"
upstreams = ["http://tasks:8080"]
pass_user_headers = true

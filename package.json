{
  "name": "@tasks-service/tasks",
  "version": "1.9.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -b && npm run build:worker && npm run build:self-hosted && npm run build:mcp && vite build",
    "build:mcp": "esbuild src/mcp/standalone.ts src/mcp/tools.ts --bundle --format=esm --platform=node --target=node24 --outdir=dist/mcp",
    "build:self-hosted": "esbuild src/self-hosted/server.ts --bundle --format=esm --platform=node --target=node24 --outfile=dist/server.js && esbuild src/self-hosted/migrate.ts --bundle --format=esm --platform=node --target=node24 --outfile=dist/migrate.js && esbuild src/mcp/create-credential.ts --bundle --format=esm --platform=node --target=node24 --outfile=dist/mcp-create-credential.js",
    "build:web": "vite build",
    "build:worker": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2023 --conditions=worker,browser --external:node:* --outfile=dist/index.js",
    "check": "node scripts/check-release-version.mjs && biome check . && npm run typecheck",
    "dev": "vite",
    "format": "biome check --write .",
    "mcp:create-credential": "esbuild src/mcp/create-credential.ts --bundle --format=esm --platform=node --target=node24 --log-level=warning --outfile=dist/mcp-create-credential.js && node dist/mcp-create-credential.js",
    "migrate:d1": "node scripts/apply-d1-migrations.mjs",
    "migrate:sqlite": "node dist/migrate.js",
    "smoke:self-hosted": "node scripts/smoke-self-hosted.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.29",
    "agents": "0.28.1",
    "fractional-indexing": "4.0.0",
    "hono": "4.13.14",
    "jose": "6.2.9",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "5.20260926.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.4",
    "vitest": "4.1.12",
    "wrangler": "4.144.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers@0.21.3": {
      "zod": "$zod"
    },
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "sharp": "0.35.5",
    "undici@^7": "7.30.1",
    "undici@^8": "8.12.2",
    "wrangler": "$wrangler"
  },
  "license": "MIT"
}
